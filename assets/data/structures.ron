// What players build: their cabin, and what comes with it.
//
// Each structure is laid out in its own frame, in meters: its front faces
// -Z (away from whoever builds it) and its middle is where it is placed.
// `size` is the ground it stands on, which nobody can dig, raise or till;
// structures that `levels_ground` flatten it, and the others need ground
// that is already nearly flat. `parts` are the models it is drawn with
// (turned in degrees, counterclockwise from above), `solids` the boxes
// nobody walks through, `lamps` where warm lights hang, and `contains` the
// structures built along with it.
// A structure's `purpose` is `Bed` (players sleep in it) or `Storage` (it
// keeps items). The `home` is the structure every player gets the item to
// build one of.
//
// The cabin is built from wall and roof tiles 2.6 m across.
(
    structures: [
        (
            id: "cabin",
            name: "Cabin",
            built_from: "cabin_deed",
            size: (5.4, 5.4),
            levels_ground: true,
            home: true,
            parts: [
                // Floor.
                (model: "town/planks.glb", at: (-1.3, -0.13, -1.3), scale: 2.6),
                (model: "town/planks.glb", at: (1.3, -0.13, -1.3), scale: 2.6),
                (model: "town/planks.glb", at: (-1.3, -0.13, 1.3), scale: 2.6),
                (model: "town/planks.glb", at: (1.3, -0.13, 1.3), scale: 2.6),
                (model: "furniture/rugRectangle.glb", at: (-1.41, 0.01, 0.53), scale: 1.8),
                // Front, the door toward +x.
                (model: "town/wall-wood-window-shutters.glb", at: (-1.3, 0.0, -1.3), turn: 90, scale: 2.6),
                (model: "town/wall-wood-doorway-square.glb", at: (1.3, 0.0, -1.3), turn: 90, scale: 2.6),
                // Back.
                (model: "town/wall-wood.glb", at: (-1.3, 0.0, 1.3), turn: 270, scale: 2.6),
                (model: "town/wall-wood.glb", at: (1.3, 0.0, 1.3), turn: 270, scale: 2.6),
                // Sides.
                (model: "town/wall-wood.glb", at: (-1.3, 0.0, -1.3), turn: 180, scale: 2.6),
                (model: "town/wall-wood-window-shutters.glb", at: (-1.3, 0.0, 1.3), turn: 180, scale: 2.6),
                (model: "town/wall-wood-window-shutters.glb", at: (1.3, 0.0, -1.3), scale: 2.6),
                (model: "town/wall-wood.glb", at: (1.3, 0.0, 1.3), scale: 2.6),
                // Roof, its ridge running from front to back.
                (model: "town/roof-high-left.glb", at: (-1.3, 2.6, -1.3), scale: 2.6),
                (model: "town/roof-high-right.glb", at: (-1.3, 2.6, 1.3), scale: 2.6),
                (model: "town/roof-high-right.glb", at: (1.3, 2.6, -1.3), turn: 180, scale: 2.6),
                (model: "town/roof-high-left.glb", at: (1.3, 2.6, 1.3), turn: 180, scale: 2.6),
                (model: "town/chimney.glb", at: (1.3, 2.6, 1.3), turn: 270, scale: 2.6),
            ],
            solids: [
                (at: (0.0, 2.47), size: (5.2, 0.26), height: 2.6),
                (at: (-2.47, 0.0), size: (0.26, 5.2), height: 2.6),
                (at: (2.47, 0.0), size: (0.26, 5.2), height: 2.6),
                (at: (-1.3, -2.47), size: (2.6, 0.26), height: 2.6),
                // Either side of the door.
                (at: (0.33, -2.47), size: (0.66, 0.26), height: 2.6),
                (at: (2.27, -2.47), size: (0.66, 0.26), height: 2.6),
            ],
            lamps: [(0.0, 2.3, 0.4)],
            contains: [
                (structure: "bed", at: (-1.6, 1.3)),
                (structure: "chest", at: (1.6, 1.95), turn: 180),
            ],
        ),
        (
            id: "bed",
            name: "Bed",
            size: (1.0, 2.0),
            purpose: Bed,
            // Its head toward the back.
            parts: [(model: "furniture/bedSingle.glb", at: (1.21, 0.0, -1.01), turn: 180, scale: 1.8)],
            solids: [(at: (0.0, 0.0), size: (1.0, 2.0), height: 0.6)],
        ),
        (
            id: "chest",
            name: "Chest",
            built_from: "chest",
            size: (0.9, 0.7),
            purpose: Storage,
            parts: [(model: "survival/chest.glb", at: (0.0, 0.0, 0.02), scale: 2.6)],
            solids: [(at: (0.0, 0.0), size: (0.7, 0.6), height: 0.6)],
        ),
    ],
)
