            name: "Tavern",
            opens: "10:00",
            closes: "23:00",
            closed_on: [],
            daily_limit: 40,
            stall: "village/counter.glb",
            buys: [
                ("strawberry", 25),
                ("wild_berries", 8),
                ("potato", 30),
            ],
            sells: [
                (item: "bread", price: 15),
                (item: "stew", price: 40),
            ],
        ),
        (
            id: "tailor",
