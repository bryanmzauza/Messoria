// How characters are built and dressed.
//
// A character is a figure of boxes, each limb turning at its joint: the body
// and the thighs at the hips, measured from the feet; the head and the upper
// arms at the neck and the shoulders, measured from the body's joint; the
// forearms at the elbows, measured from the shoulders, and the shins at the
// knees, measured from the hips. Lengths are
// in figure pixels of `pixel` meters, and the figure faces -z. Each of a
// limb's `boxes` spans `size` from `from`, relative to its joint; `inflate`
// grows a box on every side, as hair grows over a head.
//
// Boxes are painted from skins of `skin_size` texels, `texels` of them per
// figure pixel. A box's faces are unwrapped from `uv`: its top and bottom in
// a row, then its right, front, left and back faces below them. Every outfit
// and hairstyle paints only the boxes it uses (a hood, a pouch, a bun) and
// leaves the rest clear. `expressions` says where else the front of the head
// is painted, for each face a character makes.
//
// A skin is laid in layers from the skins folder: a body, an outfit over it
// and hair over both, painted in grays and tinted with a hair color (sRGB).
// Every player is dressed from the `wardrobe`, one of each, picked from who
// they are so they look the same on every screen. What a character holds sits
// in the right hand, placed by `grip` from the elbow, its model fitted so
// that its longest side is `tool_size` meters for tools and `item_size` for
// anything else. Tools are turned by `turn` (degrees around x, y and z);
// anything else is held upright.
(
    pixel: 0.0567,
    texels: 2,
    skin_size: (256, 256),
    limbs: (
        body: (
            joint: (0.0, 12.0, 0.0),
            boxes: [
                // torso
                (from: (-3.25, 0.0, -1.75), size: (6.5, 8.0, 3.5), uv: (184, 0)),
                // jacket
                (from: (-3.25, 0.0, -1.75), size: (6.5, 8.0, 3.5), uv: (0, 31), inflate: 0.25),
                // skirt
                (from: (-3.5, -2.0, -2.0), size: (7.0, 2.5, 4.0), uv: (144, 54)),
                // belt
                (from: (-3.5, 0.5, -2.0), size: (7.0, 1.0, 4.0), uv: (198, 70)),
                // collar
                (from: (-3.0, 6.5, -2.25), size: (6.0, 2.0, 4.5), uv: (188, 54)),
                // hood
                (from: (-2.5, 3.0, 1.9), size: (5.0, 4.5, 1.25), uv: (64, 70)),
                // pack
                (from: (-1.75, -0.5, 1.9), size: (3.5, 2.5, 1.5), uv: (0, 92)),
            ],
        ),
        head: (
            joint: (0.0, 8.0, 0.0),
            boxes: [
                // head
                (from: (-4.0, 0.5, -3.75), size: (8.0, 8.0, 7.5), uv: (0, 0)),
                // nose
                (from: (-0.5, 3.0, -4.25), size: (1.0, 1.0, 0.5), uv: (92, 92)),
                // shell
                (from: (-4.0, 0.5, -3.75), size: (8.0, 8.0, 7.5), uv: (62, 0), inflate: 0.6),
                // crown
                (from: (-4.5, 8.5, -4.25), size: (9.0, 1.5, 8.5), uv: (40, 31)),
                // back
                (from: (-4.5, 1.5, 3.4), size: (9.0, 7.0, 1.25), uv: (198, 31)),
                // fringe
                (from: (-4.5, 6.5, -4.6), size: (9.0, 2.5, 1.25), uv: (52, 92)),
                // side_r
                (from: (4.1, 2.5, -3.5), size: (1.0, 6.0, 6.5), uv: (124, 0)),
                // side_l
                (from: (-5.1, 2.5, -3.5), size: (1.0, 6.0, 6.5), uv: (154, 0)),
                // bun
                (from: (-1.5, 6.5, 3.75), size: (3.0, 3.0, 2.5), uv: (136, 70)),
                // tail
                (from: (-1.25, -1.5, 4.0), size: (2.5, 5.5, 1.25), uv: (230, 54)),
                // curl_a
                (from: (-3.75, 9.5, -2.5), size: (3.0, 1.5, 3.0), uv: (136, 82)),
                // curl_b
                (from: (1.0, 9.5, -0.5), size: (3.0, 1.5, 3.0), uv: (160, 82)),
                // curl_c
                (from: (-1.5, 9.5, 1.5), size: (3.0, 1.5, 2.5), uv: (232, 82)),
                // curl_d
                (from: (4.3, 3.5, -2.0), size: (1.25, 3.0, 3.0), uv: (0, 70)),
                // curl_e
                (from: (-5.55, 3.5, -2.0), size: (1.25, 3.0, 3.0), uv: (16, 70)),
                // curl_f
                (from: (-3.5, 4.0, 4.3), size: (3.0, 3.0, 1.25), uv: (20, 92)),
                // curl_g
                (from: (0.5, 2.0, 4.3), size: (3.0, 3.0, 1.25), uv: (36, 92)),
                // curl_h
                (from: (-5.0, 7.0, 0.5), size: (2.5, 2.0, 3.0), uv: (0, 82)),
                // curl_i
                (from: (2.75, 7.0, 1.5), size: (2.5, 2.0, 3.0), uv: (22, 82)),
                // beard
                (from: (-4.0, 0.0, -4.4), size: (8.0, 3.5, 1.0), uv: (44, 82)),
            ],
        ),
        right_arm: (
            joint: (4.5, 7.5, 0.0),
            boxes: [
                // rarm
                (from: (-1.25, -4.5, -1.25), size: (2.5, 4.5, 2.5), uv: (104, 54)),
                // rsleeve
                (from: (-1.25, -2.25, -1.25), size: (2.5, 2.75, 2.5), uv: (158, 70), inflate: 0.3),
            ],
        ),
        left_arm: (
            joint: (-4.5, 7.5, 0.0),
            boxes: [
                // larm
                (from: (-1.25, -4.5, -1.25), size: (2.5, 4.5, 2.5), uv: (124, 54)),
                // lsleeve
                (from: (-1.25, -2.25, -1.25), size: (2.5, 2.75, 2.5), uv: (178, 70), inflate: 0.3),
            ],
        ),
        right_leg: (
            joint: (1.6, 12.0, 0.0),
            boxes: [
                // rleg
                (from: (-1.38, -5.5, -1.38), size: (2.75, 5.5, 2.75), uv: (150, 31)),
            ],
        ),
        left_leg: (
            joint: (-1.6, 12.0, 0.0),
            boxes: [
                // lleg
                (from: (-1.38, -5.5, -1.38), size: (2.75, 5.5, 2.75), uv: (174, 31)),
            ],
        ),
        right_forearm: (
            joint: (0.0, -4.5, 0.0),
            boxes: [
                // rforearm
                (from: (-1.12, -4.0, -1.12), size: (2.25, 4.0, 2.25), uv: (32, 70)),
                // rcuff
                (from: (-1.5, -4.0, -1.5), size: (3.0, 1.25, 3.0), uv: (184, 82)),
                // rhand
                (from: (-1.5, -6.5, -1.5), size: (3.0, 2.5, 3.0), uv: (88, 70)),
            ],
        ),
        left_forearm: (
            joint: (0.0, -4.5, 0.0),
            boxes: [
                // lforearm
                (from: (-1.12, -4.0, -1.12), size: (2.25, 4.0, 2.25), uv: (48, 70)),
                // lcuff
                (from: (-1.5, -4.0, -1.5), size: (3.0, 1.25, 3.0), uv: (208, 82)),
                // lhand
                (from: (-1.5, -6.5, -1.5), size: (3.0, 2.5, 3.0), uv: (112, 70)),
            ],
        ),
        right_shin: (
            joint: (0.0, -5.5, 0.0),
            boxes: [
                // rshin
                (from: (-1.25, -6.5, -1.25), size: (2.5, 6.5, 2.5), uv: (110, 31)),
                // rboot
                (from: (-1.62, -6.5, -2.0), size: (3.25, 3.0, 4.0), uv: (48, 54)),
                // rbootcuff
                (from: (-1.75, -4.0, -1.75), size: (3.5, 1.0, 3.5), uv: (80, 82)),
            ],
        ),
        left_shin: (
            joint: (0.0, -5.5, 0.0),
            boxes: [
                // lshin
                (from: (-1.25, -6.5, -1.25), size: (2.5, 6.5, 2.5), uv: (130, 31)),
                // lboot
                (from: (-1.62, -6.5, -2.0), size: (3.25, 3.0, 4.0), uv: (76, 54)),
                // lbootcuff
                (from: (-1.75, -4.0, -1.75), size: (3.5, 1.0, 3.5), uv: (108, 82)),
            ],
        ),
    ),
    expressions: (
        blink: (238, 31),
        smile: (0, 54),
        surprise: (16, 54),
        effort: (32, 54),
    ),
    grip: (at: (0.0, -5.5, 0.0), turn: (-70.0, 0.0, 0.0), tool_size: 0.95, item_size: 0.35),
    wardrobe: (
        bodies: ["body-fair.png", "body-light.png", "body-tan.png", "body-brown.png", "body-dark.png"],
        outfits: [
            "outfit-adventurer.png",
            "outfit-overalls.png",
            "outfit-flannel.png",
            "outfit-vest.png",
            "outfit-dress.png",
        ],
        hair: [
            "hair-curly.png",
            "hair-short.png",
            "hair-long.png",
            "hair-bob.png",
            "hair-bun.png",
            "hair-ponytail.png",
            "hair-beard.png",
        ],
        hair_colors: [
            (0.13, 0.1, 0.09),
            (0.3, 0.2, 0.13),
            (0.48, 0.32, 0.2),
            (0.55, 0.25, 0.13),
            (0.8, 0.42, 0.18),
            (0.93, 0.78, 0.45),
            (0.72, 0.72, 0.72),
        ],
    ),
)
