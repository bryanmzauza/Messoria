// The people of the village: who they are, how they look (see
// characters.ron for the skins; a `hat` is one the tailor sells, from
// items.ron), which house in village.ron is theirs,
// which shop they keep, and what they do through the day.
//
// A day is a list of slots from one time to another. The first slot that
// fits the moment holds: `on` limits it to weekdays, `seasons` to seasons,
// `rain: true` to rainy days and `rain: false` to dry ones. When no slot
// fits, the villager is at home. `At` names a spot in village.ron;
// `Stroll` walks from each listed spot to the next, around and around.
//
// `lines` are what they say when talked to: the most particular lines
// whose conditions fit the moment (the hour, the season, rain or not, and
// the player's `hearts` of friendship) are picked among. `gift_lines` answer
// a gift they love, like (or shrug at) or dislike; `loves`, `likes` and
// `dislikes` list the items. `gifts` are what they give a player who first
// reaches that many hearts.
(
    villagers: [
        (
            id: "hester",
            name: "Hester Brambly",
            look: (body: "body-fair.png", eyes: (0.36, 0.22, 0.12), outfit: "outfit-dress.png", hair: "hair-bun.png", hair_color: (0.55, 0.3, 0.12)),
            home: "brambly_house",
            keeps: Some("tavern"),
            day: [
                (from: "06:30", to: "09:00", at: At("garden_east"), rain: false),
                (from: "09:30", to: "23:00", at: At("tavern_counter")),
            ],
            lines: [
                (says: "Sit down before you fall down. There's stew, and you're having some."),
                (says: "Tobin's been at that back table since noon. Don't tell him I said so."),
                (says: "Whoever farms the lots out past the river eats at my tables. House rule."),
                (says: "Marit charged me double for onions again. I'll get her back at the harvest supper."),
                (says: "Rain's good for my cabbages and terrible for my floors. Wipe your boots.", rain: true),
                (says: "Whole village crowds in here when it pours. I'm not complaining. Much.", rain: true),
                (says: "Dry as a biscuit out there. Have a cup from the well before you go back out.", rain: false),
                (says: "Spring's when I sow peas behind the kitchen. Don't trample them on your way out.", seasons: [Spring]),
                (says: "Too hot to stand by the oven. Still, someone has to bake for you lot.", seasons: [Summer]),
                (says: "Harvest suppers start soon. I'll need every turnip in the valley, mind.", seasons: [Autumn]),
                (says: "Winters used to feel long in here. Since you came, the evenings go quicker.", seasons: [Winter], hearts: 6),
                (says: "Up with the birds? I've been in the garden an hour already. Bread's nearly out.", from: "06:00", to: "10:00"),
                (says: "Morning, love. Mind the bucket, I've just scrubbed the step.", from: "06:00", to: "10:00"),
                (says: "Busiest hour of my day. Find a stool and don't block the door.", from: "18:00", to: "23:59"),
                (says: "Last orders soon. Odo's had two already, whatever he tells you.", from: "18:00", to: "23:59"),
                (says: "There you are. I kept a heel of bread back for you. Don't tell the others.", hearts: 3),
                (says: "Edric says you're the best new hand he's seen in years. He doesn't say that lightly.", hearts: 3),
                (says: "I came to this valley with nothing but a pot and a temper. The pot's still here.", hearts: 6),
            ],
            gift_lines: (
                loved: "Oh, now you've done it. I'll make something proper with this, you'll see.",
                liked: "That's kind of you, love. Into the pantry it goes.",
                disliked: "Hm. Not in my kitchen, it isn't. I'll find it a place.",
            ),
            loves: ["tomato", "strawberry"],
            likes: ["potato", "turnip", "bread"],
            dislikes: ["compost"],
            gifts: [(at: 2, item: "stew", count: 2)],
        ),
        (
            id: "odo",
            name: "Odo Flint",
            look: (body: "body-tan.png", eyes: (0.18, 0.12, 0.1), outfit: "outfit-vest.png", hair: "hair-short.png", hair_color: (0.12, 0.09, 0.07)),
            home: "flint_house",
            keeps: Some("blacksmith"),
            day: [
                (from: "07:00", to: "07:45", at: At("well_side")),
                (from: "10:00", to: "13:00", at: At("bench_north_east"), on: [Sunday], rain: false),
                (from: "13:00", to: "16:00", at: Stroll(["lane_south_east", "south_gate", "lane_south_west"]), on: [Sunday], rain: false),
                (from: "10:00", to: "16:00", at: At("tavern_stool_window"), on: [Sunday]),
                (from: "08:00", to: "17:00", at: At("smithy_counter")),
                (from: "17:30", to: "20:30", at: At("tavern_stool_window")),
            ],
            lines: [
                (says: "Good iron doesn't hurry. Neither do I."),
                (says: "Bring your tools by if they chip. I'd rather mend a thing than see it thrown away."),
                (says: "Forge is hot. Well water's cold. That's the whole trick to a long day."),
                (says: "A pickaxe that fits your hands is worth more than a strong back."),
                (says: "Rain hisses on the forge roof. Sounds like the whole sky's being quenched.", rain: true),
                (says: "Wet day. Keep your blades dry or they'll rust before supper.", rain: true),
                (says: "Dry air. Good for the bellows. Good for my temper.", rain: false),
                (says: "Spring means hoes. Every farmer in the valley wants an edge on one at once.", seasons: [Spring]),
                (says: "Summer at the anvil. I drink half the well by noon.", seasons: [Summer]),
                (says: "My father forged in this same shop. Some autumns I still hear him cursing the bellows.", seasons: [Autumn], hearts: 6),
                (says: "Winter. Only season the smithy's the best place in the village. Stand closer.", seasons: [Winter]),
                (says: "Fire's not up yet. Come back when the anvil's ringing.", from: "06:00", to: "10:00"),
                (says: "Morning. First bucket from the well is the coldest. Worth the walk.", from: "06:00", to: "10:00"),
                (says: "Done for the day. One cup at the tavern, then bed. That's the plan, anyway.", from: "18:00", to: "23:59"),
                (says: "Don't talk iron to me after dark. Talk about anything else.", from: "18:00", to: "23:59"),
                (says: "You keep your tools clean. I notice that.", hearts: 3),
                (says: "Pip asked if he could watch me work. Told him yes. Don't tell him I liked it.", hearts: 3),
                (says: "I don't say much. But I'm glad you settled here. That's the long and short of it.", hearts: 6),
            ],
            gift_lines: (
                loved: "Hm. Good. Very good. I won't forget this.",
                liked: "Useful. Thanks.",
                disliked: "What am I meant to do with this. Fine. Thanks.",
            ),
            loves: ["stew"],
            likes: ["bread", "potato", "stone"],
            dislikes: ["strawberry", "sand"],
            gifts: [(at: 3, item: "stone", count: 12)],
        ),
        (
            id: "linnet",
            name: "Linnet Quill",
            look: (body: "body-dark.png", eyes: (0.5, 0.55, 0.6), outfit: "outfit-adventurer.png", hair: "hair-long.png", hair_color: (0.1, 0.08, 0.06)),
            home: "quill_house",
            keeps: Some("tailor"),
            day: [
                (from: "10:00", to: "13:00", at: At("garden_west"), on: [Monday], rain: false),
                (from: "13:00", to: "16:00", at: At("bench_south_west"), on: [Monday], rain: false),
                (from: "09:00", to: "17:00", at: At("tailor_counter"), on: [Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday]),
                (from: "17:30", to: "19:30", at: At("chat_well_west"), rain: false),
                (from: "17:30", to: "19:30", at: At("tavern_stool_hearth"), rain: true),
            ],
            lines: [
                (says: "That shade of brown does nothing for you. Earth on earth, really."),
                (says: "A good seam is invisible. A bad one tells the whole village your business."),
                (says: "I can tell who's been digging by the knees of their trousers. You, for instance."),
                (says: "Barnaby wants a waistcoat in mustard. I am still deciding whether to allow it."),
                (says: "Rain spots wool and ruins linen. I'm staying in with my needles.", rain: true),
                (says: "Shake that coat before you come under my awning. Wet cloth smells for days.", rain: true),
                (says: "Fine and dry. The dyes take beautifully on a day like this.", rain: false),
                (says: "Every spring I think of the city workshops. Every spring I stay. You're one reason now.", seasons: [Spring], hearts: 6),
                (says: "Summer linen, please, not that heavy thing. You'll cook out on the lots.", seasons: [Summer]),
                (says: "Autumn is russet and ochre. The valley dresses better than half its people.", seasons: [Autumn]),
                (says: "Winter wool, double-stitched at the cuffs, or the wind finds its way up your sleeves.", seasons: [Winter]),
                (says: "Too early for conversation. Come back once I've threaded a needle.", from: "06:00", to: "10:00"),
                (says: "Morning light is the only honest light for matching colors.", from: "06:00", to: "10:00"),
                (says: "The well is the best place to see what everyone's wearing. That's why I sit here.", from: "18:00", to: "23:59"),
                (says: "Marit and I sit by the well and judge the village. Kindly, mostly.", from: "18:00", to: "23:59"),
                (says: "You've mended your sleeve. Badly, but you tried. Bring it to me next time.", hearts: 3),
                (says: "I put aside a bolt of blue I thought might suit you. Don't make a fuss.", hearts: 3),
                (says: "I fuss over cloth because it's easier than fussing over people. You've noticed, I think.", hearts: 6),
            ],
            gift_lines: (
                loved: "Oh. That's lovely. You've a better eye than you let on.",
                liked: "Thoughtful. Thank you.",
                disliked: "Keep it away from the cloth, please.",
            ),
            loves: ["strawberry"],
            likes: ["wild_berries", "tomato", "bread"],
            dislikes: ["compost", "soil"],
            gifts: [(at: 3, item: "tomato_seeds", count: 6)],
        ),
        (
            id: "barnaby",
            name: "Barnaby Shears",
            look: (body: "body-light.png", eyes: (0.3, 0.48, 0.25), outfit: "outfit-flannel.png", hair: "hair-curly.png", hair_color: (0.3, 0.2, 0.1)),
            home: "shears_house",
            keeps: Some("barber"),
            day: [
                (from: "10:00", to: "14:00", at: At("tavern_stool_hearth"), on: [Tuesday]),
                (from: "14:30", to: "17:00", at: Stroll(["lane_north_west", "north_gate", "lane_north_east"]), on: [Tuesday], rain: false),
                (from: "09:00", to: "16:00", at: At("barber_counter")),
                (from: "16:30", to: "19:00", at: At("bench_south_east"), rain: false),
            ],
            lines: [
                (says: "Heard the one about the turnip and the farmer? No? Neither did the turnip."),
                (says: "Sit down, sit down. A trim and the week's news, all for one price."),
                (says: "Word is someone saw a heron by the mill. Or a very tall duck. The details vary."),
                (says: "Odo let me trim his beard once. Once. My pride still has the scar."),
                (says: "Rain keeps folk in, and folk kept in want their hair cut. I love a wet day.", rain: true),
                (says: "What do you call a farmer in the rain? Damp. I'm still working on that one.", rain: true),
                (says: "Lovely dry day. Hair behaves, customers behave, I behave. Mostly.", rain: false),
                (says: "Spring, and every lad in the valley wants a cut before market day. Busy, busy.", seasons: [Spring]),
                (says: "Summer heat. Short on the sides, that's my advice to everybody. Odo included.", seasons: [Summer]),
                (says: "Autumn gossip is the best gossip. Harvest loosens tongues.", seasons: [Autumn]),
                (says: "I talk so much because quiet reminds me of my brother. He took the north road one winter.", seasons: [Winter], hearts: 6),
                (says: "Shop's not open, but the news is. Hester burnt the bread, you heard it here first.", from: "06:00", to: "10:00"),
                (says: "Early riser? Good. You'll hear everything before it's been improved.", from: "06:00", to: "10:00"),
                (says: "Closed for the day. This bench on the square is my second shop.", from: "18:00", to: "23:59"),
                (says: "Evenings on this bench, the whole village goes by. Better than a play.", from: "18:00", to: "23:59"),
                (says: "You're in my stories now, you know. Only the flattering ones, I promise.", hearts: 3),
                (says: "I tell everyone you're the hardest worker on the lots. It's even true.", hearts: 3),
                (says: "You're the only one who knows when I'm not joking. Keep that to yourself, eh.", hearts: 6),
            ],
            gift_lines: (
                loved: "Well, I never. That's going straight into a story, and you're the hero.",
                liked: "Ah, very nice of you. Very nice indeed.",
                disliked: "Ha. Funny. Oh, you weren't joking.",
            ),
            loves: ["bread"],
            likes: ["stew", "wild_berries", "tomato"],
            dislikes: ["stone", "compost"],
            gifts: [(at: 2, item: "bread", count: 3)],
        ),
        (
            id: "marit",
            name: "Marit Greengage",
            look: (body: "body-brown.png", eyes: (0.5, 0.38, 0.18), outfit: "outfit-grocer.png", hair: "hair-bob.png", hair_color: (0.2, 0.12, 0.08), hat: "hat-kerchief.png"),
            home: "greengage_house",
            keeps: Some("grocer"),
            day: [
                (from: "11:00", to: "14:00", at: At("bench_north_west"), on: [Sunday], rain: false),
                (from: "07:00", to: "08:45", at: At("garden_north_west"), rain: false),
                (from: "09:00", to: "17:00", at: At("grocer_stall"), on: [Monday, Tuesday, Wednesday, Thursday, Friday, Saturday]),
                (from: "17:30", to: "19:00", at: At("well_side")),
            ],
            lines: [
                (says: "Fair price, fair weight. Anyone who says otherwise can buy in the next valley."),
                (says: "Turnips are cheap this week. Don't pretend you knew, I can see you didn't."),
                (says: "My garden fills the stall half the year. The lots fill the other half now."),
                (says: "Haggle all you like. I enjoy it, and I always win."),
                (says: "Rain. Covers on the crates and nobody buying. Lovely.", rain: true),
                (says: "Wet greens wilt by noon. If you want a bargain, today's your day.", rain: true),
                (says: "Dry day, busy market. Stand aside unless you're buying.", rain: false),
                (says: "Spring seed is selling fast. Buy now, or plant your regrets.", seasons: [Spring]),
                (says: "Summer tomatoes. If yours come in heavy, bring them to me first.", seasons: [Summer]),
                (says: "My husband and I planted the first rows behind the stall. Each autumn I pick his side first.", seasons: [Autumn], hearts: 6),
                (says: "Winter stall is half empty. I sell what I stored and I watch every coin.", seasons: [Winter]),
                (says: "Crates first, talk later. Mornings are for setting out.", from: "06:00", to: "10:00"),
                (says: "The best produce goes before nine. Remember that.", from: "06:00", to: "10:00"),
                (says: "My feet are done. I'm sitting by the well and selling nothing to nobody.", from: "18:00", to: "23:59"),
                (says: "Linnet will be along to the well soon. She'll tell me what's wrong with my shawl.", from: "18:00", to: "23:59"),
                (says: "I set the good potatoes aside for you. Don't make me regret it.", hearts: 3),
                (says: "You weigh your crop honestly. You'd be surprised how rare that is.", hearts: 3),
                (says: "I'm sharp with the whole village. I try not to be with you. I'd hate to lose a friend.", hearts: 6),
            ],
            gift_lines: (
                loved: "Now that's quality. I'd pay good coin for that, and you just gave it.",
                liked: "Good. That'll keep. Thank you.",
                disliked: "I can't sell that, and I won't eat it.",
            ),
            loves: ["tomato"],
            likes: ["potato", "turnip", "wheat_seeds"],
            dislikes: ["sand"],
            gifts: [(at: 2, item: "turnip_seeds", count: 10)],
        ),
        (
            id: "tobin",
            name: "Tobin Ashcombe",
            look: (body: "body-light.png", eyes: (0.3, 0.5, 0.72), outfit: "outfit-carpenter.png", hair: "hair-beard.png", hair_color: (0.62, 0.3, 0.14), hat: "hat-cap.png"),
            home: "ashcombe_house",
            keeps: Some("carpenter"),
            day: [
                (from: "10:00", to: "15:00", at: Stroll(["lane_north_east", "east_gate", "lane_south_east"]), on: [Sunday], rain: false),
                (from: "08:00", to: "18:00", at: At("carpenter_stall"), on: [Monday, Tuesday, Wednesday, Thursday, Friday, Saturday]),
                (from: "18:30", to: "21:00", at: At("tavern_stool_back")),
            ],
            lines: [
                (says: "Measure twice. Cut once. Then measure again, because I don't trust the first two."),
                (says: "Oak for beams, pine for chests. Wood tells you what it wants, if you listen."),
                (says: "Built half the cabins in this valley. The other half I've been asked to fix."),
                (says: "Sawdust in my beard, sawdust in my bread. A carpenter's life."),
                (says: "Rain swells the boards. I'll leave the planing for tomorrow.", rain: true),
                (says: "Wet day. Good for indoor joinery and a long think.", rain: true),
                (says: "Dry weather. Timber seasons well in this.", rain: false),
                (says: "Spring. Folk want new fences on their lots. I want new fence posts.", seasons: [Spring]),
                (says: "Summer, and the roofs need patching before the storms. Always do.", seasons: [Summer]),
                (says: "Autumn's for stacking wood. Fill your shed before the frost fills it for you.", seasons: [Autumn]),
                (says: "I made a cradle one winter. Never needed it. It's still up in my loft.", seasons: [Winter], hearts: 6),
                (says: "Morning. The light's best now for the fine work.", from: "06:00", to: "10:00"),
                (says: "Up early? Good. Wood's quieter in the morning. So am I.", from: "06:00", to: "10:00"),
                (says: "Back table at the tavern. Same chair for twenty years. It knows me.", from: "18:00", to: "23:59"),
                (says: "Evening. Hester's saved me the corner seat. She always does.", from: "18:00", to: "23:59"),
                (says: "You've a steady hand with an axe. Might teach you a joint or two.", hearts: 3),
                (says: "Your cabin's holding up. I checked the beams. Hope you don't mind.", hearts: 3),
                (says: "I don't say much at the back table. But I keep the other chair for you now.", hearts: 6),
            ],
            gift_lines: (
                loved: "Well now. That's a fine thing. Thank you, truly.",
                liked: "Mm. That'll do nicely. Thanks.",
                disliked: "Hm. I'll put it somewhere. Out of the way.",
            ),
            loves: ["wood"],
            likes: ["stew", "bread", "axe"],
            dislikes: ["sand"],
            gifts: [(at: 3, item: "wood", count: 10)],
        ),
        (
            id: "wilma",
            name: "Wilma Thistle",
            look: (body: "body-fair.png", eyes: (0.5, 0.55, 0.6), outfit: "outfit-overalls.png", hair: "hair-bun.png", hair_color: (0.82, 0.8, 0.76)),
            home: "thistle_house",
            day: [
                (from: "07:00", to: "11:00", at: At("garden_north_east"), rain: false),
                (from: "11:00", to: "12:00", at: At("chat_well_west")),
                (from: "14:00", to: "17:00", at: At("garden_south_east"), rain: false),
                (from: "10:00", to: "16:00", at: At("tavern_stool_window"), rain: true, on: [Monday, Tuesday, Wednesday, Thursday, Friday, Saturday]),
            ],
            lines: [
                (says: "Soil doesn't lie. Look at what grows on it and you'll know what it wants."),
                (says: "Turn your compost. Smells worse for a day, works better for a season."),
                (says: "Forty years of bean husks are buried in these beds. That's why they're good."),
                (says: "Young folk water too much. Plants are like people. Spoil them and they go soft."),
                (says: "Rain. Good for the beds, bad for me. Stuck indoors like a hen in a coop.", rain: true),
                (says: "Don't you dare work your soil wet. You'll pack it hard as a road.", rain: true),
                (says: "Dry spell. Water at dawn, not noon, or you're only feeding the sky.", rain: false),
                (says: "Each spring I plant a row of my husband's seed potatoes. Fifty years from the same line.", seasons: [Spring], hearts: 6),
                (says: "Summer. Mulch your strawberries or the sun eats them before you do.", seasons: [Summer]),
                (says: "Autumn. Put your beds to sleep under leaves. They'll thank you in spring.", seasons: [Autumn]),
                (says: "Winter. Nothing to do but read the sky and complain. I'm good at both.", seasons: [Winter]),
                (says: "Dew's still on. Best time to find the slugs. Go on, look.", from: "06:00", to: "10:00"),
                (says: "I've been on my knees since first light. Don't ask me to get up.", from: "06:00", to: "10:00"),
                (says: "Swallows flying low tonight. Rain by morning. Mark me.", from: "18:00", to: "23:59"),
                (says: "Evening's for sitting still and listening to the beds grow. You'd be surprised.", from: "18:00", to: "23:59"),
                (says: "Your rows are straighter than last season. Not straight. Straighter.", hearts: 3),
                (says: "You listen. Most don't. I'll tell you a thing or two, then.", hearts: 3),
                (says: "When I'm gone, someone ought to keep these beds. I'd not mind if it were you.", hearts: 6),
            ],
            gift_lines: (
                loved: "Hah. Now that's a proper gift. You've some sense after all.",
                liked: "Hm. Good. That'll be useful.",
                disliked: "What's this for. No, don't tell me.",
            ),
            loves: ["compost", "potato_seeds"],
            likes: ["soil", "wheat_seeds", "hoe"],
            dislikes: ["stone"],
            gifts: [(at: 2, item: "potato_seeds", count: 6)],
        ),
        (
            id: "pip",
            name: "Pip Hollowell",
            look: (body: "body-tan.png", eyes: (0.3, 0.5, 0.72), outfit: "outfit-vest.png", hair: "hair-curly.png", hair_color: (0.75, 0.5, 0.2)),
            home: "hollowell_house",
            day: [
                (from: "08:00", to: "11:00", at: Stroll(["lane_north_east", "lane_north_west", "well_side"]), rain: false),
                (from: "11:00", to: "12:00", at: At("chat_well_east")),
                (from: "13:00", to: "17:00", at: Stroll(["south_gate", "lane_south_west", "lane_south_east"]), rain: false, seasons: [Spring, Summer, Autumn]),
                (from: "13:00", to: "15:00", at: Stroll(["bench_south_east", "well_side"]), rain: false, seasons: [Winter]),
                (from: "17:00", to: "19:00", at: At("bench_south_east"), rain: false),
                (from: "13:00", to: "17:00", at: At("tavern_stool_back"), rain: true),
            ],
            lines: [
                (says: "Where does the river go after the mill? Does it ever stop? Somebody must know."),
                (says: "I ran three errands before lunch. Marit gave me a plum. Have you got any errands?"),
                (says: "Odo says I can work the bellows when I'm taller. How tall is taller?"),
                (says: "One day I'll take the east road all the way to the end. Is there an end?"),
                (says: "Rain turns the lanes into rivers. I'm racing leaves down the gutter.", rain: true),
                (says: "I'm not allowed out in the rain. I'm out anyway. Don't tell anyone.", rain: true),
                (says: "It's dry enough to climb the notice board. I'm not going to. Probably.", rain: false),
                (says: "There are frogs in the river again. I counted forty before I lost count.", seasons: [Spring]),
                (says: "Summer nights I lie in the hay and think about the roads out. I'll always come back, though.", seasons: [Summer], hearts: 6),
                (says: "I'm collecting the best conkers in the valley. Want to see? They're in my pocket.", seasons: [Autumn]),
                (says: "Did you see my snow fort by the well? Tobin said it had good joints.", seasons: [Winter]),
                (says: "Morning. Hester's sending me for eggs. Want to come along?", from: "06:00", to: "10:00"),
                (says: "I'm up before the rooster. I beat him every day. Well, most days.", from: "06:00", to: "10:00"),
                (says: "I'm meant to be home. I'm just walking the long way. Very slowly.", from: "18:00", to: "23:59"),
                (says: "From the bridge you can see lanterns all down the road. Like stars fell over.", from: "18:00", to: "23:59"),
                (says: "You're my favorite grown-up. Don't tell Barnaby, he thinks it's him.", hearts: 3),
                (says: "I wrote your name on the notice board as my friend. In small letters.", hearts: 3),
                (says: "I haven't got a dad. Edric says that's alright. You being here makes it more alright.", hearts: 6),
            ],
            gift_lines: (
                loved: "For me? Really? That's the best thing anyone's ever given me.",
                liked: "Thanks. I'll keep it in my secret place.",
                disliked: "Oh. Um. Thank you. I think.",
            ),
            loves: ["strawberry", "wild_berries"],
            likes: ["bread", "tomato", "turnip_seeds"],
            dislikes: ["soil"],
            gifts: [(at: 2, item: "strawberry_seeds", count: 4)],
        ),
        (
            id: "edric",
            name: "Edric Marrow",
            look: (body: "body-brown.png", eyes: (0.36, 0.22, 0.12), outfit: "outfit-flannel.png", hair: "hair-short.png", hair_color: (0.7, 0.7, 0.68)),
            home: "marrow_house",
            day: [
                (from: "09:00", to: "12:00", at: At("bench_north_east"), rain: false),
                (from: "09:00", to: "12:00", at: At("tavern_stool_hearth"), rain: true),
                (from: "12:00", to: "14:00", at: At("tavern_stool_hearth")),
                (from: "15:00", to: "18:00", at: At("bench_north_west"), rain: false),
            ],
            lines: [
                (says: "Farmed the land past the mill for fifty years. Now I just tell others how to."),
                (says: "Plant your potatoes deep and your hopes shallow. My father used to say that."),
                (says: "Rotate your crops. Soil tires of the same thing, same as people do."),
                (says: "My knees know the weather before the sky does. Handy, if painful."),
                (says: "Rain. My old fields drank like this every spring. Did them good.", rain: true),
                (says: "Wet day for the tavern, I'd say. My bench is no place to be.", rain: true),
                (says: "Dry weather. In my day we hauled buckets up from the river by hand.", rain: false),
                (says: "Spring sowing. I'd give my good boot to walk behind a plough again.", seasons: [Spring]),
                (says: "Summer. Get your hay in before the storms, whatever the almanac says.", seasons: [Summer]),
                (says: "My boy left the valley one autumn. I'd hoped he'd take the farm. Seeing you out there helps.", seasons: [Autumn], hearts: 6),
                (says: "Winter evenings I sit with Hester's stew and tell the same three stories.", seasons: [Winter]),
                (says: "Morning. This bench catches the first sun. Sit, if you like.", from: "06:00", to: "10:00"),
                (says: "I watch the farmers head out to the lots every morning. Reminds me of my own.", from: "06:00", to: "10:00"),
                (says: "My wife used to light the lamp about now. I still look for it, out of habit.", from: "18:00", to: "23:59"),
                (says: "Early to bed, at my age. But not before one cup at the tavern.", from: "18:00", to: "23:59"),
                (says: "You remind me of myself at your age. Stubborn, and usually right.", hearts: 3),
                (says: "Your turnips looked fine this week. Better than mine ever did. Don't repeat that.", hearts: 3),
                (says: "When I go, I want you to have my old hoe. It's turned more earth than any in the valley.", hearts: 6),
            ],
            gift_lines: (
                loved: "Well, bless you. That takes me right back.",
                liked: "Thank you kindly. That's good of you.",
                disliked: "Ah. Well. It's the thought that counts, as they say.",
            ),
            loves: ["wheat", "bread"],
            likes: ["potato", "stew", "turnip_seeds"],
            dislikes: ["sand"],
            gifts: [(at: 3, item: "wheat_seeds", count: 10)],
        ),
        (
            id: "sable",
            name: "Sable Wren",
            look: (body: "body-dark.png", eyes: (0.3, 0.48, 0.25), outfit: "outfit-adventurer.png", hair: "hair-ponytail.png", hair_color: (0.08, 0.07, 0.06), hat: "hat-straw.png"),
            home: "wren_house",
            day: [
                (from: "06:30", to: "10:00", at: Stroll(["north_gate", "east_gate", "lane_north_east"]), seasons: [Spring, Summer, Autumn]),
                (from: "10:00", to: "12:00", at: At("well_side")),
                (from: "14:00", to: "17:30", at: Stroll(["west_gate", "lane_south_west", "south_gate"]), rain: false, seasons: [Spring, Summer, Autumn]),
                (from: "10:00", to: "14:00", at: At("tavern_stool_back"), seasons: [Winter]),
                (from: "17:30", to: "19:30", at: At("chat_well_east"), rain: false),
            ],
            lines: [
                (says: "I know every berry bush between here and the ridge. Not by name. Not yet."),
                (says: "Most things in the woods are edible once. A few are edible twice."),
                (says: "If it smells of almonds, leave it. If it smells of mint, it's probably mint."),
                (says: "People think the woods are quiet. They're just not talking to you."),
                (says: "Rain brings out the mushrooms. I'll be soaked through and happy.", rain: true),
                (says: "Wet woods, soft ground. Good day for roots, bad day for boots.", rain: true),
                (says: "Dry day. The river path's walkable as far as the falls. I'll be gone till dusk.", rain: false),
                (says: "Spring. Nettle tops and wild garlic down by the river. Wear gloves.", seasons: [Spring]),
                (says: "Berries along the river bend. Pick from the top, the birds take the low ones.", seasons: [Summer]),
                (says: "Autumn's the forager's harvest. Hazelnuts, rosehips, sloes. I'm never home.", seasons: [Autumn]),
                (says: "I came here one winter, half starved. Hester fed me. I've paid her back in herbs since.", seasons: [Winter], hearts: 6),
                (says: "Dew on the leaves. Best hour for gathering. You're standing on my sorrel.", from: "06:00", to: "10:00"),
                (says: "I've been at the river since dawn. The herons and I have an understanding.", from: "06:00", to: "10:00"),
                (says: "Dusk. I sort what I gathered. Don't touch the jars.", from: "18:00", to: "23:59"),
                (says: "Owls are up. That means I ought to be in. I'll stay a little longer.", from: "18:00", to: "23:59"),
                (says: "You found the bushes by the north road. Leave some for the thrushes.", hearts: 3),
                (says: "Willow bark, for aches. Don't tell Hester I've been handing out cures.", hearts: 3),
                (says: "I like company less than most. Yours I don't mind. That's a lot, from me.", hearts: 6),
            ],
            gift_lines: (
                loved: "Hm. You know me better than I thought. Thank you.",
                liked: "That'll do. Thanks.",
                disliked: "No. But thank you for thinking of me, I suppose.",
            ),
            loves: ["wild_berries"],
            likes: ["strawberry", "stew", "shovel"],
            dislikes: ["axe"],
            gifts: [(at: 2, item: "wild_berries", count: 8)],
        ),
    ],
)
