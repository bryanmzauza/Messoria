// The colors foliage and the terrain are drawn in, by material name, in sRGB,
// and how far foliage sways in the wind.
//
// Models are painted with their own colors, except foliage, which is painted
// in grays: every material named here is drawn with its texture tinted by
// this color, so leaves and grass change with the seasons. The terrain's
// ground textures (textures/ground.png) are painted in spring's colors; in
// other seasons they are tinted by how the colors named `terrain_grass`,
// `terrain_soil`, `terrain_stone` and `terrain_sand` differ from spring's. In
// winter snow covers the grass.
//
// `seasons` overrides colors for part of the year.
(
    colors: {
        "terrain_grass": (0.36, 0.52, 0.28),
        "terrain_soil": (0.4, 0.29, 0.2),
        "terrain_stone": (0.52, 0.5, 0.47),
        "terrain_sand": (0.82, 0.74, 0.52),

        "grass": (0.4, 0.57, 0.29),
        "leaves": (0.4, 0.6, 0.27),
        "leaves_light": (0.55, 0.7, 0.32),
        "needles": (0.27, 0.46, 0.3),
        "bush": (0.38, 0.56, 0.27),
    },

    seasons: {
        Summer: {
            "terrain_grass": (0.34, 0.49, 0.23),
            "grass": (0.37, 0.53, 0.24),
            "leaves": (0.34, 0.54, 0.22),
            "leaves_light": (0.48, 0.64, 0.26),
            "bush": (0.33, 0.51, 0.22),
        },
        Autumn: {
            "terrain_grass": (0.5, 0.5, 0.27),
            "grass": (0.58, 0.54, 0.29),
            "leaves": (0.88, 0.5, 0.2),
            "leaves_light": (0.95, 0.76, 0.28),
            "bush": (0.74, 0.42, 0.2),
        },
        // Snow lies on the leaves and the grass; evergreens stay dark.
        Winter: {
            "terrain_stone": (0.6, 0.6, 0.62),
            "grass": (0.8, 0.84, 0.87),
            "leaves": (0.8, 0.85, 0.88),
            "leaves_light": (0.8, 0.85, 0.88),
            "needles": (0.3, 0.42, 0.36),
            "bush": (0.76, 0.81, 0.84),
        },
    },

    // How far plants drawn in these materials sway in the wind, in meters,
    // at 1.2 m over their base and above; lower down they sway less, in
    // proportion. Parts of one plant sway together only with the same value.
    sway: {
        "leaves": 0.08,
        "leaves_light": 0.1,
        "needles": 0.05,
        "bush": 0.03,
        "grass": 0.2,
        "flower_stem": 0.15,
        "flower_red": 0.15,
        "flower_yellow": 0.15,
        "flower_purple": 0.15,
        "crop_leaves": 0.1,
        "crop_blossom": 0.1,
        "crop_fruit": 0.1,
        "wheat": 0.12,
    },
)
